{
  "name": "caredesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && npm run build -w functions",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-caredesk --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npm run build -w functions && firebase emulators:start --project demo-caredesk",
    "seed": "node scripts/seed.mjs",
    "deploy": "npm run build && npm run build -w functions && firebase deploy",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "firebase": "^12.5.0",
    "lucide-react": "^0.468.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.0",
    "firebase-tools": "^14.24.0",
    "@firebase/rules-unit-testing": "^5.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
